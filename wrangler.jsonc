{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "event-watch",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "event-watch",
      "database_id": "1f1e9ee3-ad99-4bd1-bf40-ac3ce1b37dc9",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "APP_NAME": "Event Watch",
    "APP_ORIGIN": "https://event-watch.uncover250.workers.dev",
    "GMAIL_FROM_NAME": "Event Watch",
    "GMAIL_SENDER_EMAIL": "UnCover250@gmail.com",
    "CHECK_BATCH_SIZE": "50",
    "CHECK_CONCURRENCY": "5"
  }
}
