{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "event-watch",
  "main": "src/index.js",
  "compatibility_date": "2026-09-29",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "event-watch",
      "database_id": "REPLACE_WITH_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "vars": {
    "APP_NAME": "Event Watch",
    "APP_ORIGIN": "https://REPLACE_WITH_YOUR_WORKERS_DEV_DOMAIN.workers.dev",
    "GMAIL_FROM_NAME": "Event Watch",
    "GMAIL_SENDER_EMAIL": "REPLACE_WITH_YOUR_GMAIL_ADDRESS",
    "CHECK_BATCH_SIZE": "50",
    "CHECK_CONCURRENCY": "5"
  }
}
